PORT=3000
STRIPE_SECRET_KEY=

# Optional: only needed to allow a non-localhost frontend (e.g. your production
# domain once deployed). Any http://localhost:<port> origin is always allowed.
FRONTEND_URL=

# MailerSend (contact + quote-request emails)
MAILERSEND_API_KEY=
MAIL_FROM=
MAIL_TO=

# Optional: MongoDB connection string. When set, every email attempt and every
# created order is logged to the database; when unset, both features silently
# skip logging instead of failing the request.
MONGO_URI=
